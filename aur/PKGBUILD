# Maintainer: AmanicX <amanicx@users.noreply.github.com>
pkgname=eva-bin
_pkgname=eva
pkgver=2.0.0
pkgrel=1
pkgdesc="Eva - Advanced AI Chatbot (pre-compiled binary)"
arch=('x86_64')
url="https://github.com/AmanicX/eva"
license=('MIT')
depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'glib2'
    'gtk3'
    'libcups'
    'libdrm'
    'libnotify'
    'libsecret'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'pango'
)
optdepends=(
    'libappindicator-gtk3: status tray icon support'
    'xdg-desktop-portal: desktop integration and file chooser'
)
provides=('eva')
conflicts=('eva')
options=('!strip' '!debug')

source=("https://github.com/AmanicX/eva/releases/download/v${pkgver}/eva_${pkgver}_amd64.deb")
sha256sums=('128ff9adb2a5b1b613ccf2ee1f68dbafc7b59b7fe304a4fe5b5613748758b40a')

package() {
    # Extract data archive from Debian package
    bsdtar -xf data.tar.* -C "${pkgdir}"

    # Ensure executable permissions for electron binary
    if [ -f "${pkgdir}/opt/Eva/eva" ]; then
        chmod 755 "${pkgdir}/opt/Eva/eva"
    elif [ -f "${pkgdir}/opt/eva/eva" ]; then
        chmod 755 "${pkgdir}/opt/eva/eva"
    fi

    # Ensure /usr/bin/eva symlink exists
    mkdir -p "${pkgdir}/usr/bin"
    if [ ! -f "${pkgdir}/usr/bin/eva" ]; then
        ln -sf /opt/Eva/eva "${pkgdir}/usr/bin/eva"
    fi
}
