<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive credentials, auth tokens, and hardware key material from cloud backup -->
        <exclude domain="sharedpref" path="eva_secure_storage.xml" />
        <exclude domain="sharedpref" path="eva_credentials.xml" />
        <exclude domain="file" path="eva-credentials.enc.json" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude hardware-bound cryptographic keys and private tokens from device migration -->
        <exclude domain="sharedpref" path="eva_secure_storage.xml" />
        <exclude domain="sharedpref" path="eva_credentials.xml" />
        <exclude domain="file" path="eva-credentials.enc.json" />
        <!-- Allow user chat database and preferences to migrate to new device -->
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
