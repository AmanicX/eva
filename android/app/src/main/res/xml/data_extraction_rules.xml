<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive credentials, auth tokens, and encryption keys from Android cloud backup -->
        <exclude domain="sharedpref" path="eva_credentials.xml" />
        <exclude domain="file" path="eva-credentials.enc.json" />
        <exclude domain="database" path="eva_secure_storage" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
